[Unit]
Description=plasma-graphmail-linux mail, calendar and contacts sync daemon
Documentation=https://github.com/nvaert1986/plasma-graphmail-linux
# Needs the session's keychain (KWallet) for the sign-in
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=dbus
BusName=io.github.nvaert1986.GraphMail
ExecStart=@KDE_INSTALL_FULL_BINDIR@/graphmaild
Restart=on-failure
RestartSec=10

[Install]
WantedBy=graphical-session.target
