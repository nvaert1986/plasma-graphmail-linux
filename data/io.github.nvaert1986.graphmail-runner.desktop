[Desktop Entry]
Name=Graph Mail
Comment=Search mail in Graph Mail
Comment[nl]=E-mail zoeken in Graph Mail
X-KDE-ServiceTypes=Plasma/Runner
Type=Service
Icon=io.github.nvaert1986.graphmail
X-Plasma-API=DBus
X-Plasma-DBusRunner-Service=io.github.nvaert1986.GraphMail
X-Plasma-DBusRunner-Path=/runner
X-Plasma-Request-Actions-Once=true
X-KDE-PluginInfo-EnabledByDefault=true
