[Desktop Entry]
Type=Application
Name=Graph Mail
GenericName=Mail Client
GenericName[nl]=E-mailprogramma
Comment=Mail, calendar and contacts for Microsoft 365 on KDE Plasma
Comment[nl]=E-mail, agenda en contactpersonen voor Microsoft 365 op KDE Plasma
Exec=@KDE_INSTALL_FULL_BINDIR@/plasma-graphmail-linux %U
MimeType=application/vnd.ms-outlook;application/vnd.ms-outlook-pst;message/rfc822;x-scheme-handler/mailto;
Icon=io.github.nvaert1986.graphmail
Terminal=false
Categories=Qt;KDE;Network;Email;
Keywords=mail;e-mail;email;Exchange;Microsoft 365;calendar;contacts;
Keywords[nl]=mail;e-mail;Exchange;Microsoft 365;agenda;contactpersonen;
StartupNotify=true
