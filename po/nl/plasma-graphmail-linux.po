#: src/app/accesstext.cpp:16
#, kde-format
msgctxt "@info %1 an address or name"
msgid "There is no mailbox with the address %1 in your organisation."
msgstr "Er is geen postvak met het adres %1 in uw organisatie."

#: src/app/accesstext.cpp:19
#, kde-format
msgctxt "@info %1 a mailbox"
msgid ""
"You have no access to %1. Ask its owner or your administrator to share it "
"with you."
msgstr "U hebt geen toegang tot %1. Vraag de eigenaar of uw beheerder om het met u te delen."

#: src/app/accesstext.cpp:22
#, kde-format
msgctxt "@info %1 an address"
msgid ""
"You may not send as %1. Ask your administrator for Send As or Send on Behalf "
"permission."
msgstr "U mag niet verzenden als %1. Vraag uw beheerder om de machtiging Verzenden als of Verzenden namens."

#: src/app/accesstext.cpp:25
#, kde-format
msgctxt "@info %1 an address"
msgid ""
"A calendar cannot be shared with %1: Exchange shares calendars only with "
"people, not with shared mailboxes or groups."
msgstr "Een agenda kan niet worden gedeeld met %1: Exchange deelt agenda's alleen met personen, niet met gedeelde postvakken of groepen."

#: src/app/accesstext.cpp:28
#, kde-format
msgctxt "@info"
msgid "Microsoft 365 could not be reached. Check the connection and try again."
msgstr "Microsoft 365 is niet bereikbaar. Controleer de verbinding en probeer het opnieuw."

#: src/app/accesstext.cpp:31
#, kde-format
msgctxt "@info %1 a calendar"
msgid ""
"You can only view %1: its owner did not give you permission to change it."
msgstr "U kunt %1 alleen bekijken: de eigenaar heeft u geen machtiging gegeven om deze te wijzigen."

#: src/app/accesstext.cpp:33
#, kde-format
msgctxt "@info %1 a mailbox"
msgid "Microsoft 365 refused the request for %1."
msgstr "Microsoft 365 heeft het verzoek voor %1 geweigerd."

