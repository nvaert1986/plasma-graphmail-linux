<gui name="plasma-graphmail-linux-contacts" version="3"
     xmlns="http://www.kde.org/standards/kxmlgui/1.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.kde.org/standards/kxmlgui/1.0 http://www.kde.org/standards/kxmlgui/1.0/kxmlgui.xsd">
  <MenuBar>
    <Menu name="contact">
      <text>C&amp;ontact</text>
      <Action name="new_contact"/>
      <Action name="find_contact"/>
    </Menu>
    <Menu name="view">
      <text>&amp;View</text>
      <Action name="name_order"/>
    </Menu>
    <Menu name="go">
      <Action name="go_mail"/>
      <Action name="go_calendar"/>
      <Action name="go_tasks"/>
    </Menu>
  </MenuBar>
  <ToolBar name="mainToolBar" iconText="textbesideicon">
    <text>Main Toolbar</text>
    <Action name="new_contact"/>
    <Separator/>
  </ToolBar>
</gui>
