<gui name="plasma-graphmail-linux-tasks" version="2"
     xmlns="http://www.kde.org/standards/kxmlgui/1.0"
     xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
     xsi:schemaLocation="http://www.kde.org/standards/kxmlgui/1.0 http://www.kde.org/standards/kxmlgui/1.0/kxmlgui.xsd">
  <MenuBar>
    <Menu name="task">
      <text>&amp;Task</text>
      <Action name="new_task"/>
      <Action name="new_list"/>
    </Menu>
    <Menu name="view">
      <text>&amp;View</text>
      <Action name="show_completed"/>
    </Menu>
    <Menu name="go">
      <Action name="go_mail"/>
      <Action name="go_calendar"/>
      <Action name="go_contacts"/>
    </Menu>
  </MenuBar>
  <ToolBar name="mainToolBar" iconText="textbesideicon">
    <text>Main Toolbar</text>
    <Action name="new_task"/>
    <Action name="new_list"/>
    <Action name="show_completed"/>
    <Separator/>
  </ToolBar>
</gui>
